# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI provider ---
# anthropic (Claude) or openai (OpenAI or any OpenAI-compatible API)
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: defaults are claude-sonnet-5-5 (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
# Optional: base URL for OpenAI-compatible providers, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_TIMEOUT=60
AI_RATE_LIMIT_PER_MINUTE=10
MAX_CODE_CHARS=8000
